{
  "name": "chain-wallet-sdk",
  "version": "1.0.0",
  "description": "wallet sdk all student",
  "private": true,
  "scripts": {
    "ci:template": "turbo e2e:test:template",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:template": "turbo run dev:template",
    "test": "turbo run test",
    "test:integration": "jest --config ./test/jest-integration.json",
    "lint": "turbo run lint",
    "lint:template": "turbo run lint:template",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "workspaces": [
    "apps/*",
    "reports/*",
    "libs/*"
  ],
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^17.4.0",
    "@types/node": "18.11.3",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.2",
    "turbo": "^1.6.3",
    "typescript": "^4.9.4"
  },
  "engines": {
    "node": ">=18.0.0 <=22.0.0"
  }
}
